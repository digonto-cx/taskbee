{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/manifest.json",
      "dest": "/public/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "/public/sw.js"
    },
    {
      "src": "/admin/micro",
      "dest": "/public/admin/micro.html"
    },
    {
      "src": "/admin/ck",
      "dest": "/public/admin/ck.html"
    },
    {
      "src": "/admin/job",
      "dest": "/public/admin/job.html"
    },
    {
      "src": "/admin/type",
      "dest": "/public/admin/type.html"
    },
    {
      "src": "/admin/imgbb",
      "dest": "/public/admin/imgbb.html"
    },
    {
      "src": "/admin/users",
      "dest": "/public/admin/users.html"
    },
    {
      "src": "/admin/yt",
      "dest": "/public/admin/yt.html"
    },
    {
      "src": "/admin/?$",
      "dest": "/public/admin/index.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/public/admin/$1"
    },
    {
      "src": "/tasks/micro-details",
      "dest": "/public/tasks/micro-details.html"
    },
    {
      "src": "/tasks/micro",
      "dest": "/public/tasks/micro.html"
    },
    {
      "src": "/tasks/job-details",
      "dest": "/public/tasks/job-details.html"
    },
    {
      "src": "/tasks/job",
      "dest": "/public/tasks/job.html"
    },
    {
      "src": "/tasks/type-details",
      "dest": "/public/tasks/type-details.html"
    },
    {
      "src": "/tasks/type",
      "dest": "/public/tasks/type.html"
    },
    {
      "src": "/tasks/yt-details",
      "dest": "/public/tasks/yt-details.html"
    },
    {
      "src": "/tasks/yt",
      "dest": "/public/tasks/yt.html"
    },
    {
      "src": "/tasks/task-details",
      "dest": "/public/tasks/task-details.html"
    },
    {
      "src": "/tasks/google-search",
      "dest": "/public/tasks/google-search.html"
    },
    {
      "src": "/tasks/maintenance",
      "dest": "/public/tasks/maintenance.html"
    },
    {
      "src": "/tasks",
      "dest": "/public/tasks.html"
    },
    {
      "src": "/history",
      "dest": "/public/history.html"
    },
    {
      "src": "/video",
      "dest": "/public/video.html"
    },
    {
      "src": "/withdraw",
      "dest": "/public/withdraw.html"
    },
    {
      "src": "/account",
      "dest": "/public/account.html"
    },
    {
      "src": "/refer",
      "dest": "/public/refer.html"
    },
    {
      "src": "/dashboard",
      "dest": "/public/dashboard.html"
    },
    {
      "src": "/login",
      "dest": "/public/login.html"
    },
    {
      "src": "/register",
      "dest": "/public/register.html"
    },
    {
      "src": "/$",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
